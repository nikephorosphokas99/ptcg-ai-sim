# Only rl-train/ is tracked: the official competition engine, the decks and the
# self-play training code. Everything else at the top level -- scratch notebooks,
# downloaded competition zips -- stays untracked.
/*
!/.gitignore
!/README.md
!/LICENSE
!/rl-train/

__pycache__/
*.pyc

# The official engine binaries in rl-train/engine/sample_submission/cg/ are
# tracked: they are what the competition runs, and there is no build step.
*.so
*.dll
*.dylib
!/rl-train/engine/sample_submission/cg/*

# Training output: checkpoints, the self-play pool and TensorBoard logs.
/rl-train/runs/
/rl-train/**/*.pt
/rl-train/**/*.parquet
/rl-train/**/*.npz

# WSL leaves these behind next to files copied from Windows.
*Zone.Identifier
